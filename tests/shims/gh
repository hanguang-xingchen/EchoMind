#!/usr/bin/env bash
# 测试替身：只在测试里使用，模拟 gh 的 issue list / issue view 读取行为。
set -u
sub="${1:-}"; action="${2:-}"
case "$sub $action" in
  "issue list")
    [ -f "${ECHOMIND_FIXTURE_ISSUE_LIST:-}" ] || exit 0
    jqf=""
    while [ $# -gt 0 ]; do
      if [ "$1" = "--jq" ]; then jqf="${2:-}"; break; fi
      shift
    done
    if [ -n "$jqf" ]; then jq -r "$jqf" "$ECHOMIND_FIXTURE_ISSUE_LIST"; else cat "$ECHOMIND_FIXTURE_ISSUE_LIST"; fi
    exit 0 ;;
  "issue view")
    num="$3"
    fix="${ECHOMIND_FIXTURE_DIR:-}/issue_${num}.json"
    [ -f "$fix" ] || exit 1
    jqf=""
    while [ $# -gt 0 ]; do
      if [ "$1" = "--jq" ]; then jqf="${2:-}"; break; fi
      shift
    done
    if [ -n "$jqf" ]; then jq -r "$jqf" "$fix"; else cat "$fix"; fi
    ;;
  "api "*)
    path="${2:-}"
    case "$path" in
      *stargazers*) f="${ECHOMIND_FIXTURE_DIR}/stargazers.json" ;;
      */issues/*/comments*)
        n=$(printf '%s' "$path" | sed 's#.*/issues/\([0-9]*\)/comments.*#\1#')
        f="${ECHOMIND_FIXTURE_DIR}/comments_${n}.json" ;;
      *) f="${ECHOMIND_FIXTURE_DIR}/api.json" ;;
    esac
    [ -f "$f" ] || exit 1
    jqf=""
    while [ $# -gt 0 ]; do
      if [ "$1" = "--jq" ]; then jqf="${2:-}"; break; fi
      shift
    done
    if [ -n "$jqf" ]; then jq -r "$jqf" "$f"; else cat "$f"; fi
    ;;
  *) exit 0 ;;
esac
