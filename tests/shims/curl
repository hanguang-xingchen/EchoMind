#!/usr/bin/env bash
# 测试替身：模拟 DashScope chat/completions 的真实响应结构 + curl 的 -w 输出格式。
code="${ECHOMIND_FAKE_HTTP:-200}"
reply="${ECHOMIND_FAKE_REPLY-好的，我在听。}"
if [ "$code" = "200" ]; then
  body=$(jq -n --arg c "$reply" '{
    id:"chatcmpl-fake", object:"chat.completion", created:1790000000,
    model:"qwen-plus",
    choices:[{index:0, message:{role:"assistant", content:$c}, finish_reason:"stop"}],
    usage:{prompt_tokens:120, completion_tokens:35, total_tokens:155}}')
else
  body=$(jq -n --arg e "Throttling" '{error:{code:$e, message:"fake upstream error"}, request_id:"req-fake"}')
  printf '%s\n%s\n' "$body" "$code"
  exit 0
fi
printf '%s\n%s\n' "$body" "$code"
